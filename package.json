{
	"name": "tasks",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3000",
		"build": "vite build && bun run build:entrypoints",
		"build:entrypoints": "bun build --target bun --outdir .output/entrypoints src/entrypoints/migrate.ts",
		"start": "bun .output/server/index.mjs",
		"migrate": "bun .output/entrypoints/migrate.js",
		"test": "NODE_ENV=test bun test",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"format": "biome check --write",
		"db:generate": "drizzle-kit generate",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"intent": "bun node_modules/@tanstack/intent/dist/cli.mjs"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-query": "5.104.3",
		"@tanstack/react-query-devtools": "5.104.3",
		"@tanstack/react-router": "1.170.44",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.2",
		"@viktorbarzin/auth": "0.1.0",
		"@viktorbarzin/log": "0.1.0",
		"@viktorbarzin/metrics": "0.1.0",
		"@viktorbarzin/oidc-token": "0.1.0",
		"@viktorbarzin/pg": "0.1.0",
		"@viktorbarzin/realtime": "0.1.0",
		"@viktorbarzin/runtime": "0.1.0",
		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"ical.js": "^2.2.1",
		"idb": "^8.0.4",
		"jose": "^6.2.12",
		"lucide-react": "^1.0.0",
		"nitro": "3.0.260610-beta",
		"prom-client": "^15.1.3",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@happy-dom/global-registrator": "^21.0.1",
		"@playwright/test": "^1.64.0",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/intent": "0.5.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.9",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.10.2",
		"postgres": "^3.4.9",
		"typescript": "^7.0.0",
		"vite": "^8.0.0",
		"vite-plugin-pwa": "^2.0.0"
	},
	"intent": {
		"skills": [
			"@tanstack/react-start",
			"@tanstack/start-client-core",
			"@tanstack/start-server-core",
			"@tanstack/router-core",
			"@tanstack/router-plugin"
		]
	}
}
